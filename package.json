{
  "name": "ai-test-case-generator",
  "version": "1.0.0",
  "description": "An AI-powered test case generator that automatically analyzes web pages \r and generates comprehensive test cases using Claude AI, Playwright, \r and axe-core.",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "generate": "ts-node src/index.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "allure:serve": "allure serve allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravitejapioneerblaze-code/ai-test-case-generator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ravitejapioneerblaze-code/ai-test-case-generator/issues"
  },
  "homepage": "https://github.com/ravitejapioneerblaze-code/ai-test-case-generator#readme",
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "inquirer": "^13.4.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
