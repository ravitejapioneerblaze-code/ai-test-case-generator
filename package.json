{
  "name": "ai-test-case-generator",
  "version": "1.0.0",
  "description": "Generate and run Playwright tests for any website using AI (Ollama, Anthropic or OpenAI), with Allure reports.",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "generate": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:unit": "jest",
    "allure:serve": "allure serve allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravitejapioneerblaze-code/ai-test-case-generator.git"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "ai-testing",
    "llm",
    "ollama",
    "qa",
    "typescript",
    "allure"
  ],
  "author": "Raviteja Doppalapudi",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ravitejapioneerblaze-code/ai-test-case-generator/issues"
  },
  "homepage": "https://github.com/ravitejapioneerblaze-code/ai-test-case-generator#readme",
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "inquirer": "^13.4.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
